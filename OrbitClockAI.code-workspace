      {
        "label": "小智合并版：烧录并校时（先备份）",
        "type": "process",
        "command": "python3",
        "windows": {
          "command": "python"
        },
        "args": [
          "${workspaceFolder}/scripts/orbit_ai.py",
          "flash"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "小智合并版：直接烧录并校时（不备份）",
        "type": "process",
        "command": "python3",
        "windows": {
          "command": "python"
        },
        "args": [
          "${workspaceFolder}/scripts/orbit_ai.py",
          "flash",
          "--skip-backup"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "shared"
        }
      },
      {
        "label": "小智合并版：仅 USB 校时",
        "type": "process",
        "command": "python3",
        "windows": {
          "command": "python"
        },
        "args": [
          "${workspaceFolder}/scripts/orbit_ai.py",
          "sync"
